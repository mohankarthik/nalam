# Secrets and credentials
secrets/

# Personal configuration: real names, real paths, real spreadsheet.
# The *.example.json files in data/ are the committed schema.
data/settings.json
data/people.json
plugins/telegram_bot/settings.json

# The licensed LOINC master table (data/loinc.csv, ~82MB). Input to the offline
# tools/merge_codebook.py and tools/loinc_coverage.py only; the codes we adopted
# are baked into data/analytes.json. Licensed content, too big to commit.
data/loinc.csv

# The ICD-10-CM category master table (data/icd10cm.csv). Input to the offline
# tools/conditions_coverage.py only; the codes we adopted are baked into
# data/conditions.json. ICD-10-CM is US public-domain, but the full table is
# large and generic reference data -- kept out of the repo like loinc.csv.
data/icd10cm.csv

# Analytes promoted through the review UI. Machine-written from the family's own
# reports, so treated like the generated codebook: not committed.
data/promoted.json

# The deny-list the pre-commit PII guard reads. It names real people, so
# committing it would be the exact thing it exists to prevent.
data/pii_denylist.txt

# Extracted health records.
data/health.db
data/health.db.*
data/state/

# Test fixtures built from real medical records: hand-typed values, raw
# extractions, adjudicated errors. Real people's health data does NOT go in git.
tests/fixtures/golden.json
tests/fixtures/sheet_errors.json
tests/fixtures/extracted/
tests/fixtures/golden_set.json

logs/
venv/
__pycache__/
*.pyc
.coverage
NOTES.local.md

# Raw LLM responses. The expensive artefact -- backed up, never committed.
data/llm/

# Generated ICD-10 coverage review (regenerate: tools/conditions_coverage.py)
docs/conditions-coverage-review.md
